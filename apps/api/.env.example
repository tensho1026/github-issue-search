APP_ENV=development
PORT=8080
ALLOWED_ORIGINS=http://127.0.0.1:5173
GITHUB_API_BASE_URL=https://api.github.com
# Required by the server-side GitHub REST and GraphQL adapters.
GITHUB_TOKEN=
GITHUB_REQUEST_TIMEOUT=10s
GITHUB_API_MAX_CONCURRENCY=5
PROFILE_ANALYSIS_REPOSITORY_LIMIT=20
PROFILE_ANALYSIS_CACHE_TTL=30m
PROFILE_ANALYSIS_CACHE_CAPACITY=500
REPOSITORY_DISCOVERY_RESULT_LIMIT=50
REPOSITORY_DISCOVERY_ENRICHMENT_LIMIT=10
REPOSITORY_DISCOVERY_CACHE_TTL=5m
REPOSITORY_DISCOVERY_CACHE_CAPACITY=1000
ISSUE_SEARCH_RESULT_LIMIT=50
ISSUE_SEARCH_CACHE_TTL=5m
ISSUE_SEARCH_CACHE_CAPACITY=1000
ISSUE_DETAIL_ANALYSIS_LIMIT=20
ISSUE_DETAIL_CACHE_TTL=5m
ISSUE_DETAIL_CACHE_CAPACITY=500
MANIFEST_FILE_LIMIT=3
# Optional authenticated account storage. Use only a rotated server-side
# credential; TLS is mandatory. Anonymous features do not read this value.
DATABASE_URL=
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=0
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=5s
DATABASE_MAX_CONNECTION_LIFETIME=30m
DATABASE_MAX_CONNECTION_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=30s
# Optional GitHub OAuth. Leave every value in this group empty to keep
# authentication disabled. To enable it, set the five required values together:
# GITHUB_OAUTH_CLIENT_ID, GITHUB_OAUTH_CLIENT_SECRET,
# GITHUB_OAUTH_CALLBACK_URL, AUTH_FRONTEND_URL, AUTH_FLOW_ENCRYPTION_KEY.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_OAUTH_CALLBACK_URL=
AUTH_FRONTEND_URL=
# Generate a dedicated 32-byte key with: openssl rand -hex 32
AUTH_FLOW_ENCRYPTION_KEY=
AUTH_STATE_TTL=10m
AUTH_SESSION_TTL=12h
AUTH_MAX_SESSIONS=10
# false is accepted only in development/test with loopback HTTP URLs.
AUTH_COOKIE_SECURE=false
# Empty means no reverse proxy is trusted. Use canonical CIDRs only.
TRUSTED_PROXY_CIDRS=
USE_GITHUB_API_MOCK=false
