PORT=8080
ALLOWED_ORIGINS=http://127.0.0.1:5173
GITHUB_API_BASE_URL=https://api.github.com
# Required by the server-side GitHub GraphQL issue-search adapter.
GITHUB_TOKEN=
GITHUB_REQUEST_TIMEOUT=10s
GITHUB_API_MAX_CONCURRENCY=5
PROFILE_ANALYSIS_REPOSITORY_LIMIT=20
PROFILE_ANALYSIS_CACHE_TTL=30m
PROFILE_ANALYSIS_CACHE_CAPACITY=500
ISSUE_SEARCH_RESULT_LIMIT=50
ISSUE_SEARCH_CACHE_TTL=5m
ISSUE_SEARCH_CACHE_CAPACITY=1000
ISSUE_DETAIL_ANALYSIS_LIMIT=20
ISSUE_DETAIL_CACHE_TTL=5m
ISSUE_DETAIL_CACHE_CAPACITY=500
MANIFEST_FILE_LIMIT=3
USE_GITHUB_API_MOCK=false
