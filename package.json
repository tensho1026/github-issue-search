{
  "name": "issuescout",
  "version": "0.0.0",
  "private": true,
  "description": "Find GitHub issues that match your skills, experience, and available time.",
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "architecture:check": "node scripts/ci/check-architecture.mjs",
    "build": "pnpm run build:web && pnpm run build:api",
    "build:api": "go -C apps/api build -trimpath -o ../../bin/issuescout-api ./cmd/api",
    "build:web": "pnpm --filter @issuescout/web build",
    "bundle:check": "node scripts/ci/check-web-bundle.mjs",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "contracts:check": "pnpm run contracts:lint && pnpm run contracts:policy && pnpm run contracts:fixtures && pnpm run contracts:examples:check && pnpm run contracts:embed:check && pnpm --filter @issuescout/web contracts:check && node scripts/ci/check-contract-routes.mjs && pnpm run http:check",
    "contracts:embed": "bash scripts/contracts/sync-openapi-embed.sh",
    "contracts:embed:check": "bash scripts/contracts/sync-openapi-embed.sh --check",
    "contracts:examples": "node scripts/contracts/sync-openapi-examples.mjs",
    "contracts:examples:check": "node scripts/contracts/sync-openapi-examples.mjs --check",
    "contracts:sync": "pnpm run contracts:examples && pnpm run contracts:embed",
    "contracts:fixtures": "node scripts/ci/check-contract-fixtures.mjs",
    "contracts:lint": "redocly lint --config .redocly.yaml packages/contracts/openapi.yaml",
    "contracts:policy": "node scripts/ci/check-contract-policy.mjs",
    "coverage:api": "bash scripts/ci/check-go-coverage.sh",
    "coverage:web": "pnpm --filter @issuescout/web test:coverage && node scripts/ci/check-web-coverage.mjs",
    "database:migrate": "bash scripts/database/migrate.sh up",
    "database:status": "bash scripts/database/migrate.sh status",
    "database:verify": "bash scripts/database/migrate.sh verify",
    "dev": "node scripts/dev/native-stack.mjs",
    "dev:api": "go -C apps/api run ./cmd/api",
    "dev:smoke": "node scripts/dev/native-stack.mjs --mock --smoke",
    "dev:web": "pnpm --filter @issuescout/web dev",
    "docs:check": "node scripts/ci/check-docs.mjs",
    "docs:go": "bash scripts/docs/browse-godoc.sh",
    "docs:go:check": "go run scripts/ci/check-godoc.go apps/api",
    "e2e": "pnpm run build:api && node scripts/test/build-e2e.mjs && playwright test --config apps/web/playwright.config.ts",
    "format": "prettier --write . && gofmt -w apps/api scripts/ci/check-godoc.go",
    "format:check": "prettier --check . && test -z \"$(gofmt -l apps/api scripts/ci/check-godoc.go)\"",
    "fuzz:api": "bash scripts/ci/check-go-fuzz.sh",
    "http:check": "node scripts/ci/check-httpyac.mjs",
    "http:run": "httpyac send",
    "lint": "pnpm run lint:web && pnpm run lint:api && pnpm run docs:go:check && pnpm run architecture:check && pnpm run lint:docker-free",
    "lint:api": "cd apps/api && golangci-lint run -c ../../.golangci.yml ./...",
    "lint:docker-free": "node scripts/ci/check-docker-free.mjs",
    "lint:docs": "markdownlint-cli2 && pnpm run docs:check",
    "lint:web": "pnpm --filter @issuescout/web lint",
    "lint:workflow-policy": "node scripts/ci/check-workflow-policy.mjs",
    "lint:workflows": "actionlint && pnpm run lint:workflow-policy",
    "migrations:check": "node scripts/ci/check-migrations.mjs",
    "performance:api": "node scripts/ci/check-go-performance.mjs",
    "quality:strict": "pnpm run check && pnpm run coverage:api && pnpm run fuzz:api && pnpm run performance:api && pnpm run coverage:web && pnpm run bundle:check && pnpm run contracts:check && pnpm run lint:docs && pnpm run lint:workflows",
    "release:build": "bash scripts/release/build-release.sh",
    "release:compare": "node scripts/release/compare-artifacts.mjs",
    "release:reproducibility": "node scripts/release/check-reproducibility.mjs",
    "release:smoke": "bash scripts/release/smoke-artifacts.sh",
    "test": "pnpm run test:web && pnpm run test:api && pnpm run test:dev",
    "test:api": "go -C apps/api test ./...",
    "test:dev": "node --test scripts/dev/*.test.mjs",
    "test:web": "pnpm --filter @issuescout/web test",
    "typecheck": "pnpm --filter @issuescout/web typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@redocly/cli": "2.41.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "httpyac": "6.16.7",
    "jsdom": "30.0.1",
    "markdownlint-cli2": "0.23.2",
    "mermaid": "11.16.0",
    "prettier": "3.9.6",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@4.2.0": "4.3.0"
    }
  }
}
