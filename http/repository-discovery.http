### Discover public repositories with documented defaults
# @name discoverRepositoriesDefault
POST {{apiBaseUrl}}/api/repositories/search
Accept: application/json
Content-Type: application/json
X-Request-ID: httpyac-repository-default

{}

### Combine cheap GitHub qualifiers with analyzed OSS evidence
# @name discoverRepositoriesAdvanced
POST {{apiBaseUrl}}/api/repositories/search?page=1&perPage=20
Accept: application/json
Content-Type: application/json
X-Request-ID: httpyac-repository-filtered

{
  "languages": ["Go", "TypeScript"],
  "technologies": ["Gin", "React"],
  "licenses": ["Apache-2.0", "MIT"],
  "categories": ["framework", "tooling"],
  "minimumStars": 100,
  "minimumForks": 5,
  "minimumOpenIssues": 1,
  "maximumOpenIssues": 500,
  "updatedWithinDays": 180,
  "maximumDifficulty": 3,
  "minimumReadiness": 50,
  "forkPolicy": "exclude",
  "excludeArchived": true
}

### Require bounded Japanese README evidence
# @name discoverRepositoriesJapaneseReadme
POST {{apiBaseUrl}}/api/repositories/search?page=1&perPage=10
Accept: application/json
Content-Type: application/json
X-Request-ID: httpyac-repository-japanese-readme

{
  "languages": ["Go"],
  "hasJapaneseReadme": true
}

### Inspect fork-only discovery
# @name discoverForkRepositories
POST {{apiBaseUrl}}/api/repositories/search
Accept: application/json
Content-Type: application/json
X-Request-ID: httpyac-repository-forks

{
  "forkPolicy": "only",
  "minimumStars": 0
}

### Exercise a valid empty-result threshold
# @name discoverRepositoriesNoResults
POST {{apiBaseUrl}}/api/repositories/search
Accept: application/json
Content-Type: application/json
X-Request-ID: httpyac-repository-empty

{
  "minimumStars": 10000000
}

### Repeat defaults to observe X-IssueScout-Cache
# @name discoverRepositoriesCached
POST {{apiBaseUrl}}/api/repositories/search
Accept: application/json
Content-Type: application/json
X-Request-ID: httpyac-repository-cache-repeat

{}

### [negative] Reject an unsupported SPDX identifier before GitHub I/O
# @name discoverRepositoriesInvalidLicense
POST {{apiBaseUrl}}/api/repositories/search
Content-Type: application/json
X-Request-ID: httpyac-repository-invalid-license

{
  "licenses": ["Not-A-License"]
}

### [negative] Reject an inverted open-issue range before GitHub I/O
# @name discoverRepositoriesInvalidIssueRange
POST {{apiBaseUrl}}/api/repositories/search
Content-Type: application/json
X-Request-ID: httpyac-repository-invalid-range

{
  "minimumOpenIssues": 100,
  "maximumOpenIssues": 10
}
